<Window x:Class="Corporate_Training_Management.TrainingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trainings" Height="500" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock Text="Name"/>
                <TextBox x:Name="NameBox" Width="150"/>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="Start Date"/>
                <DatePicker x:Name="StartDatePicker" Width="150"/>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="End Date"/>
                <DatePicker x:Name="EndDatePicker" Width="150"/>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="Location"/>
                <TextBox x:Name="LocationBox" Width="150"/>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="Instructor"/>
                <ComboBox x:Name="InstructorDropdown" Width="150" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="TrainingGrid" Grid.Row="1" AutoGenerateColumns="True" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add" Width="75" Margin="5" Click="Add_Click"/>
            <Button Content="Edit" Width="75" Margin="5" Click="Edit_Click"/>
            <Button Content="Delete" Width="75" Margin="5" Click="Delete_Click"/>
            <Button Content="Back" Width="75" Margin="5" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Window>
