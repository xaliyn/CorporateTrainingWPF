<Window x:Class="Corporate_Training_Management.InstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instructors" Height="400" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Name"/>
                <TextBox x:Name="NameBox" Width="200"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Expertise"/>
                <TextBox x:Name="ExpertiseBox" Width="200"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="InstructorsGrid" Grid.Row="1" AutoGenerateColumns="True" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add" Width="75" Margin="5" Click="Add_Click"/>
            <Button Content="Edit" Width="75" Margin="5" Click="Edit_Click"/>
            <Button Content="Delete" Width="75" Margin="5" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Window>

