<Window x:Class="Corporate_Training_Management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corporate Training Manager" Height="300" Width="400">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Welcome" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Button Content="Manage Instructors" Width="200" Margin="0,0,0,10" Click="OpenInstructors"/>
            <Button Content="Manage Participants" Width="200" Margin="0,0,0,10" Click="OpenParticipants"/>
            <Button Content="Manage Trainings" Width="200" Click="OpenTrainings"/>
        </StackPanel>
    </Grid>
</Window>